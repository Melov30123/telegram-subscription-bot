# Required
BOT_TOKEN=123456789:replace_me
DATABASE_URL=postgresql://subscription_bot:change_me@postgres:5432/subscription_bot
CHANNEL_ID=-1001234567890
ADMIN_IDS=123456789

# Initial plan (created only when the plans table is empty)
DEFAULT_PLAN_CODE=monthly
DEFAULT_PLAN_TITLE=30 days
DEFAULT_PLAN_PRICE_STARS=100
DEFAULT_PLAN_DURATION_DAYS=30

# Digital guide (leave GUIDE_DOWNLOAD_URL empty to disable the product)
GUIDE_DOWNLOAD_URL=
GUIDE_PRICE_STARS=500
GUIDE_TITLE=Практический гайд

# Public information
SUPPORT_USERNAME=@your_support
TERMS_URL=https://example.com/terms
DEFAULT_LANGUAGE=ru

# Runtime
TIMEZONE=Europe/Moscow
PORT=8080
LOG_LEVEL=INFO
DROP_PENDING_UPDATES=false
BROADCAST_RATE_PER_SECOND=20
